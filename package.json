{
  "name": "dyson-dashboard",
  "version": "1.0.0",
  "description": "Dyson Protocol Address Dashboard",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui --host 0.0.0.0",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report --host 0.0.0.0",
    "playwright:install": "playwright install --with-deps",
    "lint": "eslint . --fix",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@cosmjs/encoding": "^0.28.0",
    "@cosmjs/proto-signing": "^0.33.0",
    "@headlessui/vue": "^1.7.23",
    "@heroicons/vue": "^2.2.0",
    "@jsonforms/core": "^3.6.0",
    "@jsonforms/vue": "^3.6.0",
    "@jsonforms/vue-vanilla": "^3.6.0",
    "@keplr-wallet/types": "^0.12.112",
    "@vueuse/core": "^13.6.0",
    "axios": "^1.11.0",
    "cosmjs-types": "^0.9.0",
    "dompurify": "^3.1.6",
    "marked": "^12.0.2",
    "monaco-editor": "^0.52.2",
    "pinia": "^3.0.3",
    "prismjs": "^1.30.0",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "vue": "^3.5.18",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.2",
    "@tailwindcss/typography": "^0.5.16",
    "@tailwindcss/vite": "^4.1.11",
    "@typescript-eslint/eslint-plugin": "^8.21.0",
    "@typescript-eslint/parser": "^8.21.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/test-utils": "^2.4.6",
    "daisyui": "^5.0.50",
    "eslint": "^9.18.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "^9.32.0",
    "jsdom": "^26.1.0",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.7.3",
    "vite": "^7.0.6",
    "vitest": "^3.2.4",
    "vue-tsc": "^2.1.10"
  }
}
