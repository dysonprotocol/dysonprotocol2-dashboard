---
config:
  layout: elk
---
flowchart TB
 subgraph s1["cosmos/auth/v1beta1"]
        A1["BaseAccount
fields: address: cosmos.AddressString
Populate via: Query.Accounts, Query.Account, Query.AccountInfo"]
        A2["ModuleAccount
fields: base_account.address: cosmos.AddressString
Populate via: Query.ModuleAccounts, Query.ModuleAccountByName"]
        A3["Params
Populate via: Query.Params"]
  end
 subgraph s2["cosmos/bank/v1beta1"]
        B1["Balance
fields: address: cosmos.AddressString, coins[]
Populate via: Query.AllBalances, Query.Balance"]
        B2["Supply (Coin[])
Populate via: Query.TotalSupply, Query.SupplyOf"]
        B3["Metadata
Populate via: Query.DenomsMetadata, Query.DenomMetadata, Query.DenomMetadataByQueryString"]
        B4["SendEnabled
Populate via: Query.SendEnabled"]
        B5["Params
Populate via: Query.Params"]
  end
 subgraph s3["cosmos/staking/v1beta1"]
        S1["Validator
fields: operator_address: cosmos.AddressString
Populate via: Query.Validators, Query.Validator"]
        S2["Delegation
fields: delegator_address: cosmos.AddressString
validator_address: cosmos.ValidatorAddressString
Populate via: Query.Delegation, Query.DelegatorDelegations, Query.ValidatorDelegations"]
        S3["UnbondingDelegation
fields: delegator_address: cosmos.AddressString
validator_address: cosmos.ValidatorAddressString
Populate via: Query.UnbondingDelegation, Query.DelegatorUnbondingDelegations, Query.ValidatorUnbondingDelegations"]
        S4["Redelegation
fields: delegator_address: cosmos.AddressString
validator_src_address/dst_address: cosmos.ValidatorAddressString
Populate via: Query.Redelegations"]
        S5["LastValidatorPower
fields: address: cosmos.AddressString
Populate via: n/a (no direct query)"]
        S6["Params
Populate via: Query.Params"]
  end
 subgraph s4["cosmos/authz/v1beta1"]
        Z1["GrantAuthorization
fields: granter: cosmos.AddressString, grantee: cosmos.AddressString
authorization[Any(Authorization)], expiration
Populate via: Query.Grants, Query.GranterGrants, Query.GranteeGrants"]
  end
 subgraph s5["cosmos/gov/v1"]
        G1["Proposal
fields: id, proposer: cosmos.AddressString, ...
Populate via: Query.Proposal, Query.Proposals"]
        G2["Deposit
fields: proposal_id, depositor: cosmos.AddressString, amount[]
Populate via: Query.Deposit, Query.Deposits"]
        G3["Vote
fields: proposal_id, voter: cosmos.AddressString, options[]
Populate via: Query.Vote, Query.Votes"]
        G4["Params
Populate via: Query.Params"]
        G5["Constitution (string)
Populate via: Query.Constitution"]
  end
 subgraph s6["dysonprotocol/crontask/v1"]
        C1["Task
fields: task_id, creator: cosmos.AddressString, ...
Populate via: Query.TaskByID, Query.TasksByAddress, Query.TasksByStatusTimestamp, Query.TasksByStatusGasPrice, Query.TasksAll"]
        C2["Params
Populate via: Query.Params"]
  end
 subgraph s7["dysonprotocol/script/v1"]
        D1["Script
fields: address: cosmos.AddressString, version, code, update_height
Populate via: Query.ScriptInfo"]
        D2["Params
Populate via: Query.Params"]
  end
 subgraph s8["dysonprotocol/storage/v1"]
        E1["Storage
fields: owner: cosmos.AddressString, index, data, updated_height, updated_timestamp, hash
Populate via: Query.StorageGet, Query.StorageList"]
        E2["Params
Populate via: Query.Params"]
  end
 subgraph s9["dysonprotocol/nameservice/v1"]
        N1["Commitment
fields: owner (address), hexhash, data, timestamp, valuation
Populate via: n/a (no direct query)"]
        N2["Params
Populate via: Query.Params"]
  end
 subgraph s10["dysonprotocol/nft/v1beta1"]
        F1["Class
fields: id, name, symbol, description, uri, uri_hash, data[Any]
Populate via: Query.Class, Query.Classes"]
        F2["Entry
fields: owner (address), nfts[NFT]
Populate via: Query.NFTs(owner)"]
        F3["NFT
fields: class_id, id, uri, uri_hash, data[Any]
Populate via: Query.NFT, Query.NFTs"]
  end
    A1 -- address → address --> B1
    A2 -- "base_account.address → address" --> B1
    A1 -- "address = delegator_address" --> S2 & S3 & S4
    S1 -- "operator_address = validator_address" --> S2 & S3
    S1 -- "operator_address = validator_src/dst_address" --> S4
    A1 -- "address = granter" --> Z1
    A1 -- "address = grantee" --> Z1
    A2 -- "base_account.address = granter" --> Z1
    A2 -- "base_account.address = grantee" --> Z1
    A1 -- "address = proposer" --> G1
    A1 -- "address = depositor" --> G2
    A1 -- "address = voter" --> G3
    A1 -- "address = creator" --> C1
    A2 -- "base_account.address = creator" --> C1
    A1 -- "address = script.address" --> D1
    A1 -- "address = owner" --> E1
    A2 -- "base_account.address = owner" --> E1
    A1 -- "address = Commitment.owner" --> N1
    A1 -- "address = Entry.owner" --> F2
    F3 -- class_id → id --> F1
    